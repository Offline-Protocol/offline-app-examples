{
  "name": "@offline-app-examples/tictactogether",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "dev": "react-native start",
    "start:fresh": "react-native start --reset-cache",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write App.tsx src __tests__",
    "format:check": "prettier --check App.tsx src __tests__"
  },
  "dependencies": {
    "@offline-app-examples/mesh": "workspace:*",
    "@offline-app-examples/ui": "workspace:*",
    "@offline-protocol/mesh-sdk": "^0.27.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-native": "0.85.2",
    "react-native-css-interop": "^0.2.7",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-reanimated": "~4.6.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "~0.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@jest/globals": "^29.6.3",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.2",
    "@react-native/codegen": "0.85.2",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/gradle-plugin": "0.85.2",
    "@react-native/jest-preset": "0.85.2",
    "@react-native/metro-config": "0.85.2",
    "@react-native/typescript-config": "0.85.2",
    "@types/react": "^19.2.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "hermes-compiler": "250829098.0.10",
    "jest": "^29.6.3",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "babel-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ]
  }
}
